# ============================================================
# Deep Truth Search — 环境配置模板
# 复制为 .env 并填入实际值：cp .env.example .env
# ============================================================

# ── LLM 配置 ─────────────────────────────────────────────────
LLM_PROVIDER=openai                   # openai | anthropic
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=120                       # 秒
LLM_MAX_RETRIES=2

# ── 评分 LLM 配置（可选，不填则使用主 LLM）──────────────────
# SCORING_LLM_API_KEY=sk-your-scoring-api-key
# SCORING_LLM_BASE_URL=https://api.openai.com/v1
# SCORING_LLM_MODEL=gpt-4o
# SCORING_LLM_MAX_RETRIES=2

# ── 搜索 API 配置 ────────────────────────────────────────────
SEARCH_PROVIDER=serper                # serper（Google Search via serper.dev）
SEARCH_API_KEY=your-serper-api-key-here

# ── Web 服务配置 ──────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8888
WEB_AUTO_OPEN=true                    # 启动后自动打开浏览器

# ── Agent 控制参数 ────────────────────────────────────────────
MAIN_AGENT_MAX_ROUNDS=3               # Main Agent 最大循环轮次
MAIN_AGENT_MAX_TURNS=12               # Main Agent Loop 最大轮次
SEARCH_AGENT_BUDGET=5                 # Search Agent 每轮最大搜索次数
SEARCH_AGENT_MAX_VISITS=10            # 每轮最大页面访问数
SEARCH_AGENT_MAX_TURNS=8              # Search Agent Loop 最大轮次
QUALITY_THRESHOLD=60                  # 证据质量准入阈值 (0-100)
MEMORY_THRESHOLD=75                   # 来源记忆准入阈值 (0-100)，高于此分数才记入长期记忆
MAX_PARALLEL_SEARCHES=3               # batch_search 最大并发搜索数

# ── HTTP 请求配置 ─────────────────────────────────────────────
HTTP_CONNECT_TIMEOUT=10               # 秒
HTTP_READ_TIMEOUT=30                  # 秒
HTTP_USER_AGENT=DeepTruthSearch/1.0
HTTP_RATE_LIMIT_PER_DOMAIN=1.0        # 同域名请求间隔（秒）
SEARCH_API_INTERVAL=1.0               # 搜索 API 调用间隔（秒）

# ── 记忆系统配置 ──────────────────────────────────────────────
MEMORY_STORAGE=json                   # json | sqlite（后续扩展）
MEMORY_DIR=data/memory
DISCLOSURE_WINDOW_SIZE=15             # 披露窗口大小
